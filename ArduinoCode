#include <Servo.h>
#include <EEPROM.h>
#include <avr/interrupt.h>
#include <LedControl.h>

#define POT_PIN A0
#define BUTTON_PIN 2
#define SERVO_PIN 9

#define DATA_PIN 4
#define CLOCK_PIN 7
#define LATCH_PIN 8

Servo lockServo;

LedControl matrix = LedControl(3, 6, 5, 1);
unsigned long changeModeDisplayStart = 0;
byte lastMatrixMode = 255;
byte lastMatrixDigit = 255;

const byte matrixDigits[10][8] = {
  {0x3C,0x66,0x6E,0x76,0x66,0x66,0x3C,0x00},
  {0x18,0x38,0x18,0x18,0x18,0x18,0x7E,0x00},
  {0x3C,0x66,0x06,0x0C,0x30,0x60,0x7E,0x00},
  {0x3C,0x66,0x06,0x1C,0x06,0x66,0x3C,0x00},
  {0x0C,0x1C,0x3C,0x6C,0x7E,0x0C,0x0C,0x00},
  {0x7E,0x60,0x7C,0x06,0x06,0x66,0x3C,0x00},
  {0x1C,0x30,0x60,0x7C,0x66,0x66,0x3C,0x00},
  {0x7E,0x06,0x0C,0x18,0x30,0x30,0x30,0x00},
  {0x3C,0x66,0x66,0x3C,0x66,0x66,0x3C,0x00},
  {0x3C,0x66,0x66,0x3E,0x06,0x0C,0x38,0x00}
};

const byte matrixCheck[8] = {
  0x00,0x01,0x03,0x06,0x6C,0x38,0x10,0x00
};
const byte matrixCross[8] = {
  0x00,0x66,0x3C,0x18,0x18,0x3C,0x66,0x00
};
const byte matrixLock[8] = {
  0x18,0x24,0x24,0x24,0x7E,0x5A,0x5A,0x7E
};
const byte matrixC[8] = {
  0x00,0x3C,0x66,0x60,0x60,0x66,0x3C,0x00
};

byte savedPIN[4] = {4, 8, 2, 6};
byte enteredPIN[4];

byte pinIndex = 0;
byte selectedDigit = 0;
byte wrongAttempts = 0;

volatile unsigned long timerTicks = 0;
volatile bool buttonEvent = false;
volatile unsigned long interruptCount = 0;

enum State {
  ENTERING,
  UNLOCKED,
  WRONG_PIN,
  BLOCKED,
  CHANGE_PIN
};

State state = ENTERING;

unsigned long stateStart = 0;
unsigned long lastPotTime = 0;

bool buttonActive = false;
bool longPressHandled = false;

bool buttonStable = false;
bool lastButtonReading = false;

unsigned long buttonChangeTime = 0;
unsigned long pressStart = 0;

const unsigned long UNLOCK_TIME = 10000;
const unsigned long BLOCK_TIME = 30000;
const unsigned long ERROR_TIME = 1500;
const unsigned long HOLD_TIME = 3000;
const unsigned long DEBOUNCE_TIME = 25;

byte ledState = 0xFF;

ISR(TIMER2_COMPA_vect) {
  timerTicks++;
}

unsigned long getTime() {
  noInterrupts();
  unsigned long t = timerTicks;
  interrupts();

  return t;
}

void setupTimer2() {
  noInterrupts();

  TCCR2A = 0;
  TCCR2B = 0;
  TCNT2 = 0;

  OCR2A = 249;

  TCCR2A |= (1 << WGM21);
  TCCR2B |= (1 << CS22);

  TIMSK2 |= (1 << OCIE2A);

  interrupts();
}

void buttonISR() {
  buttonEvent = true;
  interruptCount++;
}

void updateLEDs(byte value) {

  PORTB &= ~(1 << PB0);

  for (int i = 7; i >= 0; i--) {

    if (value & (1 << i)) {
      PORTD |= (1 << PD4);
    } else {
      PORTD &= ~(1 << PD4);
    }

    PORTD |= (1 << PD7);

    PORTD &= ~(1 << PD7);
  }

  PORTB |= (1 << PB0);
}

void savePIN() {

  EEPROM.update(0, 0x00);

  for (byte i = 0; i < 4; i++) {
    EEPROM.update(i + 1, savedPIN[i]);
  }

  EEPROM.update(0, 0xA5);
}

void loadPIN() {

  bool valid = EEPROM.read(0) == 0xA5;

  byte loadedPIN[4];

  if (valid) {

    for (byte i = 0; i < 4; i++) {

      loadedPIN[i] = EEPROM.read(i + 1);

      if (loadedPIN[i] > 9) {
        valid = false;
      }
    }
  }

  if (valid) {

    for (byte i = 0; i < 4; i++) {
      savedPIN[i] = loadedPIN[i];
    }

  } else {

    const byte defaultPIN[4] = {4, 8, 2, 6};

    for (byte i = 0; i < 4; i++) {
      savedPIN[i] = defaultPIN[i];
    }

    savePIN();
  }
}

bool checkPIN() {

  for (byte i = 0; i < 4; i++) {

    if (enteredPIN[i] != savedPIN[i]) {
      return false;
    }
  }

  return true;
}

void refreshIndicators() {
  byte value = 0;

  for (byte i = 0; i < pinIndex && i < 4; i++) {
    value |= (1 << (i + 1));
  }

  if (state == UNLOCKED || state == CHANGE_PIN) {
    value |= (1 << 5);
  }

  if (state == WRONG_PIN) {
    value |= (1 << 6);
  }

  if (state == BLOCKED) {
    value |= (1 << 7);
  }

  if (value != ledState) {
    ledState = value;
    updateLEDs(value);
  }
}

void refreshMatrix() {

  byte mode = 0;

  if (state == UNLOCKED) mode = 1;
  else if (state == WRONG_PIN) mode = 2;
  else if (state == BLOCKED) mode = 3;
  else if (state == CHANGE_PIN &&
           getTime() - changeModeDisplayStart < 800) mode = 4;

  byte digit = selectedDigit;
  if (mode == lastMatrixMode && (mode != 0 || digit == lastMatrixDigit)) {
    return;
  }

  lastMatrixMode = mode;
  lastMatrixDigit = digit;

  const byte *pattern;
  if (mode == 1) pattern = matrixCheck;
  else if (mode == 2) pattern = matrixCross;
  else if (mode == 3) pattern = matrixLock;
  else if (mode == 4) pattern = matrixC;
  else pattern = matrixDigits[digit];

  for (byte row = 0; row < 8; row++) {
    byte rotatedRow = 0;
    for (byte col = 0; col < 8; col++) {
      if (pattern[7 - col] & (1 << (7 - row))) {
        rotatedRow |= (1 << (7 - col));
      }
    }
    matrix.setRow(0, row, rotatedRow);
  }
}

void lockSafe() {
  lockServo.write(0);
}

void unlockSafe() {
  lockServo.write(90);
}

void resetInput() {

  pinIndex = 0;
  selectedDigit = 0;

  state = ENTERING;

  lockSafe();
}

void startPINChange() {

  changeModeDisplayStart = getTime();
  state = CHANGE_PIN;
  stateStart = getTime();

  pinIndex = 0;
  selectedDigit = 0;

  longPressHandled = true;
}

void confirmDigit() {

  if (state != ENTERING && state != CHANGE_PIN) {
    return;
  }

  int value = analogRead(POT_PIN);
  selectedDigit = min(value / 103, 9);

  enteredPIN[pinIndex] = selectedDigit;
  pinIndex++;
  unsigned long now = getTime();

  if (state == CHANGE_PIN) {
    stateStart = now;
  }

  if (pinIndex < 4) {
    return;
  }

  if (state == CHANGE_PIN) {

    for (byte i = 0; i < 4; i++) {
      savedPIN[i] = enteredPIN[i];
    }

    savePIN();

    pinIndex = 0;
    state = UNLOCKED;
    stateStart = now;
    return;
  }

  stateStart = now;

  if (checkPIN()) {

    state = UNLOCKED;
    wrongAttempts = 0;

    unlockSafe();
  } else {

    wrongAttempts++;
    if (wrongAttempts >= 3) {

      state = BLOCKED;
    } else {

      state = WRONG_PIN;
    }
  }
}

void handleButton() {

  unsigned long now = getTime();

  bool reading = (PIND & (1 << PD2)) == 0;

  bool event;

  noInterrupts();
  event = buttonEvent;
  buttonEvent = false;
  interrupts();

  if (event && reading && !buttonStable) {
    buttonChangeTime = now;
  }

  if (reading != lastButtonReading) {
    lastButtonReading = reading;
    buttonChangeTime = now;
  }

  if (now - buttonChangeTime < DEBOUNCE_TIME) {
    return;
  }

  if (reading != buttonStable) {

    buttonStable = reading;

    if (buttonStable) {

      buttonActive = true;
      longPressHandled = false;
      pressStart = now;

      if (state == UNLOCKED) {
        stateStart = now;
      }

    } else {

      if (buttonActive && !longPressHandled) {

        if (state == ENTERING ||
            state == CHANGE_PIN) {

          confirmDigit();
        }
      }

      buttonActive = false;
    }
  }

  if (buttonActive &&
      buttonStable &&
      !longPressHandled &&
      state == UNLOCKED &&
      now - pressStart >= HOLD_TIME) {

    longPressHandled = true;

    startPINChange();
  }
}

void handlePotentiometer() {

  if (state != ENTERING && state != CHANGE_PIN) {
    return;
  }

  unsigned long now = getTime();

  if (now - lastPotTime < 100) {
    return;
  }

  lastPotTime = now;

  int value = analogRead(POT_PIN);
  byte digit = min(value / 103, 9);

  if (digit != selectedDigit) {

    selectedDigit = digit;
  }
}

void handleState() {

  unsigned long now = getTime();
  unsigned long elapsed = now - stateStart;

  switch (state) {

    case ENTERING:
      break;

    case UNLOCKED:

      if (buttonActive && buttonStable) {
        break;
      }

      if (elapsed >= UNLOCK_TIME) {
        resetInput();
      }

      break;

    case WRONG_PIN:

      if (elapsed >= ERROR_TIME) {
        resetInput();
      }

      break;

    case BLOCKED:

      if (elapsed >= BLOCK_TIME) {

        wrongAttempts = 0;
        resetInput();
      }

      break;

    case CHANGE_PIN:

      if (elapsed >= UNLOCK_TIME) {
        resetInput();
      }

      break;
  }
}

void setup() {
  matrix.shutdown(0, false);
  matrix.setIntensity(0, 5);
  matrix.clearDisplay(0);

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(POT_PIN, INPUT);

  pinMode(DATA_PIN, OUTPUT);
  pinMode(CLOCK_PIN, OUTPUT);
  pinMode(LATCH_PIN, OUTPUT);

  updateLEDs(0);

  lockServo.attach(SERVO_PIN);
  lockSafe();

  loadPIN();

  attachInterrupt(
    digitalPinToInterrupt(BUTTON_PIN),
    buttonISR,
    FALLING
  );

  setupTimer2();
  resetInput();
}

void loop() {

  handleButton();
  handlePotentiometer();
  handleState();
  refreshIndicators();
  refreshMatrix();
}
